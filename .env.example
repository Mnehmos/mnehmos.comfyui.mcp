# mnehmos.comfyui.mcp — environment template
# Copy to .env (gitignored) or set in the environment. Defaults point at the
# canonical TMRI ComfyUI service (F:\ComfyUI, endpoint 127.0.0.1:8188).

# ComfyUI HTTP endpoint (standardized in F:\ComfyUI\README.md — do not drift)
COMFYUI_URL=http://127.0.0.1:8188

# Canonical directories of the ComfyUI base path
COMFYUI_WORKFLOWS_DIR=F:/ComfyUI/workflows
COMFYUI_MODELS_DIR=F:/ComfyUI/models
COMFYUI_INPUT_DIR=F:/ComfyUI/input
COMFYUI_OUTPUT_DIR=F:/ComfyUI/output

# SQLite database for run history + audit trail (created on first run)
COMFYUI_MCP_DB=./data/comfyui-mcp.db
